{
  "name": "@scryer/headless-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:browser": "tsc -p tsconfig.browser.json",
    "test:browser": "npm run build:browser && node --test --test-concurrency=1 ../tests/browser/test_*.mjs",
    "pretest": "make -C ../engine cli",
    "test": "node --experimental-strip-types --test ../tests/client/*.mjs"
  },
  "devDependencies": {
    "playwright-core": "1.63.0",
    "typescript": "5.9.3"
  }
}
